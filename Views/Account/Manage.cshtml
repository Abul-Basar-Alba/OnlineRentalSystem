@using OnlineRentalSystem.Models.Identity
@{

     var userDetails = (ApplicationUser)ViewBag.UserDetails;
     var userRoles = (List<string>)ViewBag.Roles;
}
<div class="row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-2">
                 FirstName
            </dt>
            <dd class="col-sm-10">
               @userDetails.FirstName
            </dd>
            <dt class="col-sm-2">
                LastName
            </dt>
            <dd class="col-sm-10">
                @userDetails.LastName
            </dd>
            <dt class="col-sm-2">
                Email
            </dt>
            <dd class="col-sm-10">
                @userDetails.Email
            </dd>
            <dt class="col-sm-2">
                Address
            </dt>
            <dd class="col-sm-10">
                @userDetails.Address,
                @userDetails.City,
                @userDetails.Country
            </dd>
            <dt class="col-sm-2">
                DateRegistered
            </dt>
            <dd class="col-sm-10">
                @userDetails.DateRegistered
            </dd>
            <dt class="col-sm-2">
              Roles
            </dt>
            <dd class="col-sm-10">
                @foreach(var role in userRoles)
                {
                    <p> @role</p>
                }
            </dd>
            
        </dl>
    </div>
    <div class="col-md-2"></div>
</div>
